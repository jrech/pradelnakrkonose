---
import '../styles/global.css';
import SegmentLandingPage from '../components/SegmentLandingPage.astro';

const hotelWellness = {
  meta: {
    title: 'Praní prádla pro hotely v Krkonoších | Prádelna Krkonoše',
    description: 'Spolehlivý prádelenský servis pro hotely a wellness v Krkonoších. Hotelové prádlo, ručníky, župany a pracovní oděvy včetně pravidelného svozu.',
    ogDescription: 'Hotelové prádlo, ručníky a župany čisté a včas. Svoz přizpůsobíme obsazenosti i hlavní sezóně.',
    ogImage: '/images/services/hotels/hero.webp',
  },
  hero: {
    eyebrow: 'PRO HOTELY A WELLNESS',
    title: 'Prádelenský servis pro hotely a wellness',
    copy: 'Postaráme se o hotelové prádlo, ručníky, župany i pracovní oděvy. Pravidelně a podle potřeb vašeho provozu.',
    image: '/images/services/hotels/hero.webp',
    imageAlt: 'Hotelový resort v Krkonoších',
  },
  services: {
    title: 'Kompletní péče o hotelový textil',
    copy: 'Od pokojů přes wellness až po zázemí personálu. Rozsah služby nastavíme podle vašeho provozu.',
    image: '/images/services/hotels/service.webp',
    imageAlt: 'Čistý hotelový pokoj připravený pro hosty',
    items: [
      { number: '01', title: 'Hotelové prádlo', copy: 'Povlečení, prostěradla a další textil pro pokoje a ubytovací provozy.' },
      { number: '02', title: 'Ručníky a župany', copy: 'Textil pro koupelny, wellness, spa a bazénové provozy.' },
      { number: '03', title: 'Pracovní oděvy', copy: 'Prádlo pro housekeeping, kuchyně, obsluhu a další personál.' },
      { number: '04', title: 'Svoz podle provozu', copy: 'Četnost svozu přizpůsobíme obsazenosti, sezóně a potřebám vašeho provozu.' },
    ],
  },
  needs: {
    eyebrow: 'PRO HOTELOVÝ PROVOZ',
    title: 'Prádlo nesmí být starost.',
    items: [
      { number: '01', title: 'Sezóna není každý měsíc stejná', copy: 'Kapacitu přizpůsobíme obsazenosti i hlavním sezónním špičkám.' },
      { number: '02', title: 'Čisté prádlo potřebujete včas', copy: 'Svozy nastavíme podle rytmu vašeho provozu.' },
      { number: '03', title: 'Každý provoz funguje jinak', copy: 'Množství, četnost i způsob předání nastavíme individuálně.' },
    ],
  },
  season: {
    eyebrow: 'HLAVNÍ SEZÓNA',
    title: 'Připraveni i na hlavní sezónu',
    copy: [
      'V Krkonoších dobře víme, že leden a červen nejsou totéž.',
      'Svoz i kapacitu proto nastavíme podle obsazenosti vašeho hotelu a během hlavní sezóny se přizpůsobíme vyšším objemům.',
    ],
    image: '/images/services/hotels/about.webp',
    imageAlt: 'Profesionální hotelové prádlo v prádelně',
  },
  process: {
    title: 'Jak probíhá spolupráce krok za krokem?',
    copy: 'Vše nastavíme podle rytmu vašeho hotelu a požadované četnosti svozu.',
    steps: [
      { number: '01', title: 'Nezávazná poptávka', copy: 'Řeknete nám, co váš provoz potřebuje.', image: '/images/services/hotels/step-1.webp' },
      { number: '02', title: 'Nastavení spolupráce', copy: 'Domluvíme četnost svozu, množství a způsob předání.', image: '/images/services/hotels/step-2.webp' },
      { number: '03', title: 'Pravidelný svoz a praní', copy: 'Prádlo vyzvedneme a postaráme se o jeho vyprání a přípravu.', image: '/images/services/hotels/step-3.webp' },
      { number: '04', title: 'Čisté prádlo zpět', copy: 'Čisté prádlo přivezeme zpět podle domluveného režimu.', image: '/images/services/hotels/step-4.webp' },
    ],
  },
  faqs: [
    ['Jak často prádlo svážíte?', 'Četnost svozu nastavíme podle obsazenosti, objemu prádla a provozního režimu vašeho hotelu.'],
    ['Zvládnete vyšší objemy během hlavní sezóny?', 'Ano. Kapacitu a harmonogram plánujeme s ohledem na sezónní špičky v Krkonoších.'],
    ['Jaké druhy hotelového prádla perete?', 'Pereme povlečení, prostěradla, ručníky, osušky, župany a vybrané pracovní oděvy hotelového personálu.'],
    ['Perete také ručníky a wellness župany?', 'Ano. Zpracováváme textil pro hotelové koupelny, wellness, spa i bazénové provozy.'],
    ['Je stanovené minimální množství prádla?', 'Minimální množství řešíme individuálně podle četnosti svozu, typu textilu a trasy rozvozu.'],
    ['Kam v Krkonoších prádlo svážíte?', 'Sídlíme ve Vrchlabí a obsluhujeme B2B provozy po Krkonoších a v blízkém okolí. Konkrétní trasu potvrdíme při úvodní domluvě.'],
  ] as Array<[string, string]>,
  faqIntro: 'Praktické informace o praní a svozu pro hotely a wellness provozy.',
  formType: 'Hotel / wellness',
  formNotePlaceholder: 'Např. množství prádla, četnost svozu nebo s čím vám můžeme pomoct.',
};
---

<SegmentLandingPage config={hotelWellness} />
