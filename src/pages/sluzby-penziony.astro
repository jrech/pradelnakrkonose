    title: 'Domluvme praní pro vaše ubytování',
    copy: 'Napište nám o svém penzionu nebo apartmánech. Svoz nastavíme podle obsazenosti a střídání hostů.',
  },
  faqs: [
    ['Jak často prádlo svážíte?', 'Četnost svozu nastavíme podle obsazenosti, objemu prádla a provozního režimu vašeho ubytování.'],
    ['Lze svoz přizpůsobit obsazenosti?', 'Ano. Režim svozu můžeme upravit podle rezervací, turnusů a sezónních změn.'],
    ['Perete ložní prádlo i ručníky?', 'Ano. Zpracováváme povlečení, prostěradla, ručníky, osušky a další koupelnový textil.'],
    ['Zvládnete větší objem během hlavní sezóny?', 'Kapacitu plánujeme s ohledem na sezónní špičky a předem domluvený harmonogram.'],
    ['Je stanovené minimální množství prádla?', 'Minimum řešíme individuálně podle četnosti svozu, typu textilu a trasy rozvozu.'],
    ['Kam v Krkonoších prádlo svážíte?', 'Sídlíme ve Vrchlabí a obsluhujeme B2B provozy po Krkonoších a v blízkém okolí.'],
  ] as Array<[string, string]>,
  faqIntro: 'Praktické informace o praní a svozu pro penziony a apartmány.',
  formType: 'Penzion / apartmány',
  formNotePlaceholder: 'Např. množství prádla, četnost svozu nebo s čím vám můžeme pomoct.',
} satisfies SegmentPageConfig;
---

<SegmentLandingPage config={pensiony} />
