---
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import HomepageSocialProof from '../components/HomepageSocialProof.astro';
import truckIcon from 'lucide-static/icons/truck.svg?raw';
import washingMachineIcon from 'lucide-static/icons/washing-machine.svg?raw';
import capacityIcon from 'lucide-static/icons/layers-3.svg?raw';
import serviceIcon from 'lucide-static/icons/clock-3.svg?raw';

const clients = [
  {
    title: 'Hotely a wellness',
    copy: 'Čisté prádlo, ručníky a župany i během hlavní sezóny.',
    image: '/images/client-hotel.webp',
    alt: 'Hotelový resort v Krkonoších',
    position: 'center',
    href: '/sluzby-hotely',
  },
  {
    title: 'Penziony a apartmány',
    copy: 'Pravidelný svoz podle obsazenosti a střídání hostů.',
    image: '/images/client-pension.webp',
    alt: 'Penzion v horské krajině Krkonoš',
    position: 'center',
    href: '/sluzby-penziony',
  },
  {
    title: 'Chaty a chalupy',
    copy: 'Flexibilní svoz podle turnusů, víkendů i sezóny.',
    image: '/images/client-cottage-vrchlabi.webp',
    alt: 'Horská chata v Krkonoších',
    position: 'center',
    href: '/sluzby-chaty',
  },
  {
    title: 'Restaurace a gastro',
    copy: 'Ubrusy, textil i pracovní oděvy čisté a připravené včas.',
    image: '/images/client-gastro.webp',
    alt: 'Restaurace s terasou v Krkonoších',
    position: 'bottom',
    href: '/sluzby-gastro',
  },
];

const benefits = [
  { icon: truckIcon, title: 'Vyzvednutí a rozvoz', copy: 'Prádlo vyzvedneme přímo u vás a čisté ho zase přivezeme.' },
  { icon: washingMachineIcon, title: 'Praní a mandlování', copy: 'Pereme a mandlujeme prádlo pro hotely, restaurace i další provozy.' },
  { icon: capacityIcon, title: 'Kapacita podle sezóny', copy: 'Objem svozu přizpůsobíme sezóně i aktuální obsazenosti.' },
  { icon: serviceIcon, title: 'Pravidelný servis', copy: 'Termíny svozu nastavíme tak, aby odpovídaly rytmu vašeho provozu.' },
];

const steps = [
  { title: 'Nezávazná poptávka', copy: 'Řeknete nám, co potřebujete a jak váš provoz funguje.', image: '/images/process/inquiry.webp' },
  { title: 'Nastavení spolupráce', copy: 'Domluvíme četnost svozu, rozsah služby a praktické detaily.', image: '/images/process/partnership.webp' },
  { title: 'Svoz a praní', copy: 'Prádlo vyzvedneme a postaráme se o jeho vyprání a přípravu.', image: '/images/step-3.webp' },
  { title: 'Čisté prádlo zpět', copy: 'Čisté prádlo přivezeme zpět podle domluveného režimu.', image: '/images/step-4.webp' },
];

const faqs = [
  ['Jak často k nám můžete jezdit?', 'Frekvenci svozu nastavíme podle velikosti provozu, obsazenosti a sezóny. U pravidelných partnerů počítáme i s víkendovými špičkami.'],
  ['Jaké typy prádla zpracováváte?', 'Ložní a stolní prádlo, ručníky, osušky, župany i vybrané pracovní oděvy pro ubytovací a gastro provozy.'],
  ['Zvládnete výkyvy během hlavní sezóny?', 'Ano. Kapacitu a harmonogram plánujeme s ohledem na sezónní provoz v Krkonoších.'],
  ['Působíte pouze ve Vrchlabí?', 'Sídlíme ve Vrchlabí a obsluhujeme B2B provozy po Krkonoších a v blízkém okolí. Konkrétní trasu potvrdíme při úvodní domluvě.'],
];


---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Prádelna Krkonoše | Praní a svoz prádla pro firmy"
      description="Profesionální praní a pravidelný svoz provozního prádla pro hotely, penziony, apartmány a gastro provozy ve Vrchlabí a Krkonoších."
      image="/images/hero3.webp"
      path="/"
    />
    <title>Prádelna Krkonoše | Praní a svoz prádla pro firmy</title>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && (!location.hash || location.hash === '#top')) {
        document.documentElement.classList.add('hero-motion');
        window.addEventListener('load', () => {
          window.setTimeout(() => {
            if (document.documentElement.classList.contains('hero-motion')) {
              document.documentElement.classList.add('hero-motion-fallback');
            }
          }, 3000);
        }, { once: true });
      }
    </script>
  </head>
  <body class="homepage">
    <a class="skip-link" href="#main">Přejít na obsah</a>

    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="Prádelna Krkonoše, domů">
        <img src="/logo-white.svg" alt="Prádelna Krkonoše" width="129" height="66" />
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav"><span>Menu</span></button>
      <nav id="site-nav" class="site-nav" aria-label="Hlavní navigace">
        <a href="#pro-koho">Provozy</a>
        <a href="#sluzby">Služby</a>
        <a href="#jak-to-funguje">Jak to funguje</a>
        <a href="/o-nas">O nás</a>
        <a href="/kontakt">Kontakt</a>
        <a class="button button--small" href="#poptavka">Nezávazná poptávka</a>
        <div class="site-nav__contact">
          <span>Rychlý kontakt</span>
          <a href="tel:+420773798008">+420 773 798 008</a>
          <a href="mailto:info@pradelnakrkonose.cz">info@pradelnakrkonose.cz</a>
          <a href="https://maps.google.com/?q=Kpt.+Jaroše+496,+543+01+Vrchlabí+1" target="_blank" rel="noreferrer">Kpt. Jaroše 496, 543 01 Vrchlabí 1</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <div class="hero__media-reveal" data-hero-media-reveal>
          <div class="hero__media-scale" data-hero-media-scale>
            <img
              class="hero__media"
              src="/images/hero3-1440.webp"
              srcset="/images/hero3-768.webp 768w, /images/hero3-1440.webp 1440w, /images/hero3.webp 1535w"
              sizes="100vw"
              alt=""
              aria-hidden="true"
              fetchpriority="high"
            />
            <div class="hero__veil"></div>
          </div>
        </div>
        <div class="hero__content wrap">
          <p class="eyebrow eyebrow--light">PRÁDELENSKÝ SERVIS PRO KRKONOŠE</p>
          <h1 id="hero-title">
            <span class="hero__line-mask"><span class="hero__line">Čisté prádlo včas.</span></span>
            <span class="hero__line-mask"><span class="hero__line">I v plné sezóně.</span></span>
          </h1>
          <p class="hero__lead">Pravidelný svoz a rozvoz prádla pro hotely,<br class="hero__lead-break" /> penziony, apartmány a gastro po celých Krkonoších.</p>
          <div class="hero__actions">
            <a class="button" href="#poptavka">Nezávazná poptávka</a>
            <a class="text-link text-link--light hero__how" href="#jak-to-funguje">Jak to funguje</a>
          </div>
        </div>
      </section>

      <section id="sluzby" class="section service">
        <div class="wrap service__layout">
          <div class="service__intro reveal">
            <p class="eyebrow">SLUŽBY</p>
            <h2>Kompletní prádelenský servis pro provozy v Krkonoších</h2>
            <p class="lead">Od svozu přes praní až po čisté prádlo zpět u vás.<br />Pravidelně a podle potřeb vašeho provozu.</p>
          </div>
          <figure class="service__image reveal reveal--media" style="--delay:80ms">
            <img
              src="/images/service-720.webp"
              srcset="/images/service-480.webp 480w, /images/service-720.webp 720w, /images/service.webp 885w"
              sizes="(min-width: 1100px) 50vw, 100vw"
              alt="Provoz Prádelny Krkonoše ve Vrchlabí"
              loading="lazy"
            />
          </figure>
          <div class="service__content">
            <div class="benefit-list">
              {benefits.map((benefit, index) => (
                <div class="benefit reveal" style={`--delay:${index * 110}ms`}>
                  <span class="benefit__icon" aria-hidden="true" set:html={benefit.icon}></span>
                  <span class="benefit__copy">
                    <h3>{benefit.title}</h3>
                    <p>{benefit.copy}</p>
                  </span>
                </div>
              ))}
            </div>
            <a class="button service__cta reveal" style="--delay:440ms" href="#poptavka">Nezávazně poptat servis</a>
          </div>
        </div>
      </section>

      <section id="pro-koho" class="section section--clients">
        <div class="wrap">
          <div class="section-heading reveal">
            <p class="eyebrow">PRO KOHO PEREME</p>
            <h2>Pracujeme s provozy,<br />kde je spolehlivost klíčová</h2>
          </div>
          <div class="client-grid">
            {clients.map((client, index) => (
              <article class="client-card reveal" style={`--delay:${index * 70}ms`}>
                <a class="client-card__link" href={client.href}>
                  <div class="client-card__image">
                    <img src={client.image} alt={client.alt} loading="lazy" style={`object-position:${client.position}`} />
                  </div>
                  <div class="client-card__content">
                    <h3>{client.title}</h3>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="jak-to-funguje" class="section process">
        <div class="wrap process__track">
          <div class="process__stage">
            <div class="section-heading reveal">
              <p class="eyebrow">JAK TO FUNGUJE</p>
              <h2>Jak probíhá spolupráce<br />krok za krokem?</h2>
              <p class="lead">Vše nastavíme tak, aby vám praní prádla zabíralo co nejméně času a starostí.</p>
            </div>
            <div class="process-story" data-process-story>
              <figure class="process-story__media" aria-hidden="true">
                {steps.map((step, index) => (
                  <img
                    class:list={['process-story__image', { 'is-active': index === 0 }]}
                    src={step.image}
                    alt=""
                    loading="lazy"
                    data-process-image={index}
                  />
                ))}
              </figure>
              <div class="process-story__steps">
                <span class="process-story__line" aria-hidden="true"><span data-process-progress></span></span>
                <ol>
                  {steps.map((step, index) => (
                    <li class:list={['process-story__step', { 'is-active': index === 0 }]} data-process-step={index}>
                      <span class="process-story__marker" aria-hidden="true" data-process-marker={index}></span>
                      <div>
                        <h3>{step.title}</h3>
                        <p>{step.copy}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </div>
        </div>
      </section>

      <HomepageSocialProof />

      <section id="o-nas" class="section section--tint about">
        <div class="wrap about__layout">
          <div class="about__content reveal" style="--delay:80ms">
            <p class="eyebrow">PŘÍMO Z VRCHLABÍ</p>
            <h2>Z Vrchlabí.<br />Pro celé Krkonoše.</h2>
            <div class="about__copy">
              <p>Prádlo pereme přímo ve Vrchlabí a odtud vyrážíme za provozy po celých Krkonoších. Díky krátkým trasám a vlastnímu svozu dokážeme reagovat pružně i v hlavní sezóně.</p>
              <p>Známe místní provoz i to, jak rychle se během sezóny mění obsazenost. Spolupráci proto nastavujeme podle skutečných potřeb vašeho provozu.</p>
            </div>
            <a class="text-link" href="/o-nas">O naší prádelně <span aria-hidden="true">→</span></a>
          </div>
          <figure class="about__main-image reveal">
            <img src="/images/about-1.webp" alt="Prádlo připravené ve vozících v provozu prádelny ve Vrchlabí" width="1086" height="1448" loading="lazy" decoding="async" />
          </figure>
          <div class="about__details">
            <figure class="reveal" style="--delay:80ms">
              <img src="/images/about-2.webp" alt="Tým prádelny při zpracování a skládání prádla" width="1448" height="1086" loading="lazy" decoding="async" />
            </figure>
            <figure class="reveal" style="--delay:140ms">
              <img src="/images/services/hotels/about.webp" alt="Průmyslové pračky v provozu prádelny" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </section>

      <section id="faq" class="section section--tint faq" aria-labelledby="faq-title">
        <div class="wrap faq__layout">
          <div class="faq__intro reveal">
            <p class="eyebrow">ČASTÉ DOTAZY</p>
            <h2 id="faq-title">Na co se nás<br />nejčastěji ptáte?</h2>
          </div>
          <div class="accordion reveal">
            {faqs.map(([question, answer], index) => (
              <details open={index === 0}>
                <summary>{question}<span aria-hidden="true">+</span></summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="kontakt" class="section contact" aria-labelledby="contact-title">
        <div class="wrap contact__layout">
          <div class="contact__intro reveal">
            <p class="eyebrow">NEZÁVAZNÁ POPTÁVKA</p>
            <h2 id="contact-title">Řekněte nám,<br />jak vám můžeme<br />pomoci.</h2>
            <p class="lead">Napište nám krátce o svém provozu. Ozveme se zpravidla do 24 hodin a navrhneme další postup.</p>
          </div>
          <form id="poptavka" class="inquiry-form reveal" novalidate style="--delay:80ms" aria-labelledby="inquiry-title">
            <div class="form-heading"><h3 id="inquiry-title">Vaše poptávka</h3><p>Povinné údaje jsou označené hvězdičkou.</p></div>
            <div class="form-row">
              <label>Jméno a příjmení *<input name="jmeno" autocomplete="name" placeholder="Jan Novák" required /></label>
              <label>Název provozu<input name="firma" autocomplete="organization" placeholder="Název hotelu či provozu" /></label>
            </div>
            <div class="form-row">
              <label>E-mail *<input type="email" name="email" autocomplete="email" placeholder="novak@email.cz" required /></label>
              <label>Telefon *<input type="tel" name="telefon" autocomplete="tel" placeholder="+420 777 000 000" required /></label>
            </div>
            <label>Typ provozu *
              <select name="provoz" required>
                <option value="">Vyberte typ provozu</option>
                <option>Hotel / wellness</option><option>Penzion / apartmány</option><option>Horská chata / chalupa</option><option>Restaurace / gastro</option><option>Jiný provoz</option>
              </select>
            </label>
            <label>Zpráva / poptávka
              <textarea name="poznamka" rows="7" placeholder="Např. množství prádla, četnost svozu nebo s čím vám můžeme pomoct."></textarea>
            </label>
            <div class="form-actions">
              <button class="button" type="submit">Odeslat poptávku</button>
              <a class="button button--outline" href="tel:+420773798008">Raději zavolám</a>
            </div>
            <p class="consent-note">Vaše údaje použijeme k vyřízení poptávky a nepředáme je třetím stranám pro marketingové účely. <a href="/ochrana-osobnich-udaju">Více o ochraně osobních údajů</a>.</p>
            <p class="form-status" aria-live="polite" aria-atomic="true"></p>
          </form>
          <div class="contact__info reveal" style="--delay:140ms">
            <address>
              <a href="tel:+420773798008"><span>Telefon</span><strong>+420 773 798 008</strong></a>
              <a href="mailto:info@pradelnakrkonose.cz"><span>E-mail</span><strong>info@pradelnakrkonose.cz</strong></a>
              <a href="https://maps.google.com/?q=Kpt.+Jaroše+496,+543+01+Vrchlabí+1" target="_blank" rel="noreferrer"><span>Adresa</span><strong>Kpt. Jaroše 496, 543 01 Vrchlabí 1</strong></a>
            </address>
            <p class="contact__hours"><span>Otevírací doba</span><strong>Po–Pá · 7:30–14:00</strong></p>
            <a class="contact__map" href="https://maps.google.com/?q=Kpt.+Jaroše+496,+543+01+Vrchlabí+1" target="_blank" rel="noreferrer" aria-label="Otevřít adresu v mapách">
              <img src="/images/map.webp" alt="Mapa s polohou Prádelny Krkonoše ve Vrchlabí" loading="lazy" />
              <span class="contact__pin" aria-hidden="true"></span>
              <span class="contact__map-label">Otevřít v mapách ↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

    <script src="../scripts/site.ts"></script>
  </body>
</html>
