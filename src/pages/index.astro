---
import '../styles/global.css';

const clients = [
  {
    title: 'Hotely a wellness',
    copy: 'Čisté prádlo, ručníky a župany pro zážitek, na který se hosté vrací.',
    image: '/images/client-hotel.webp',
    position: 'center',
    href: '/sluzby-hotely',
  },
  {
    title: 'Penziony a apartmány',
    copy: 'Postaráme se o prádlo mezi pobyty, abyste se mohli soustředit na hosty.',
    image: '/images/client-pension.webp',
    position: 'center',
    href: '#poptavka',
  },
  {
    title: 'Chaty a chalupy',
    copy: 'Spolehlivý servis i během víkendových špiček a hlavní sezóny.',
    image: '/images/client-cottage.webp',
    position: 'center',
    href: '#poptavka',
  },
  {
    title: 'Restaurace a gastro',
    copy: 'Od ubrusů po pracovní oděvy. Vždy připravené na další směnu.',
    image: '/images/client-gastro.webp',
    position: 'bottom',
    href: '#poptavka',
  },
];

const benefits = [
  { icon: '/icons/service-1.svg', title: 'Vyzvednutí a rozvoz', copy: 'Pravidelné svozy nastavíme podle vašeho provozu.' },
  { icon: '/icons/service-2.svg', title: 'Praní a mandlování', copy: 'Profesionální péče s důrazem na čistotu a kvalitu.' },
  { icon: '/icons/service-3.svg', title: 'Flexibilní objemy', copy: 'Kapacitu přizpůsobíme sezóně i aktuální obsazenosti.' },
  { icon: '/icons/service-4.svg', title: 'Stálý servis', copy: 'Jeden spolehlivý partner pro celý váš provoz.' },
];

const steps = [
  { number: '01', title: 'Poptáte spolupráci', copy: 'Řeknete nám typ provozu, objem prádla a kdy nás potřebujete.', image: '/images/step-1.webp' },
  { number: '02', title: 'Nastavíme spolupráci', copy: 'Domluvíme harmonogram svozu, ceny a vše důležité pro hladký provoz.', image: '/images/step-2.webp' },
  { number: '03', title: 'Pro prádlo přijedeme', copy: 'V domluvený čas prádlo vyzvedneme přímo u vás.', image: '/images/step-3.webp' },
  { number: '04', title: 'Vrátíme čisté a včas', copy: 'Vyprané, usušené a připravené na další hosty nebo směnu.', image: '/images/step-4.webp' },
];

const faqs = [
  ['Jak často k nám můžete jezdit?', 'Frekvenci svozu nastavíme podle velikosti provozu, obsazenosti a sezóny. U pravidelných partnerů počítáme i s víkendovými špičkami.'],
  ['Jaké typy prádla zpracováváte?', 'Ložní a stolní prádlo, ručníky, osušky, župany i vybrané pracovní oděvy pro ubytovací a gastro provozy.'],
  ['Zvládnete výkyvy během hlavní sezóny?', 'Ano. Kapacitu a harmonogram plánujeme s ohledem na sezónní provoz v Krkonoších.'],
  ['Působíte pouze ve Vrchlabí?', 'Sídlíme ve Vrchlabí a obsluhujeme B2B provozy po Krkonoších a v blízkém okolí. Konkrétní trasu potvrdíme při úvodní domluvě.'],
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Profesionální prádelenský servis s rozvozem pro hotely, penziony, apartmány a gastro provozy v Krkonoších." />
    <meta name="theme-color" content="#033e46" />
    <meta property="og:title" content="Prádelna Krkonoše | B2B prádelenský servis" />
    <meta property="og:description" content="Čisté prádlo včas. I v plné sezóně." />
    <meta property="og:image" content="/images/hero.webp" />
    <title>Prádelna Krkonoše | Prádelenský servis pro firmy</title>
    <link rel="icon" href="/logo.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Přejít na obsah</a>

    <header class="site-header" data-header>
      <a class="brand" href="#top" aria-label="Prádelna Krkonoše – domů">
        <img src="/logo-white.svg" alt="Prádelna Krkonoše" width="129" height="66" />
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav"><span>Menu</span></button>
      <nav id="site-nav" class="site-nav" aria-label="Hlavní navigace">
        <a href="#pro-koho">Provozy</a>
        <a href="#sluzby">Služby</a>
        <a href="#jak-to-funguje">Jak to funguje</a>
        <a href="#faq">FAQ</a>
        <a href="#kontakt">Kontakt</a>
        <a class="button button--small" href="#poptavka">Nezávazná poptávka</a>
        <div class="site-nav__contact">
          <span>Rychlý kontakt</span>
          <a href="tel:+420727839795">+420 727 839 795</a>
          <a href="mailto:info@pradelnakrkonose.cz">info@pradelnakrkonose.cz</a>
          <a href="https://maps.google.com/?q=Kpt.+Jaroše+496,+Vrchlabí" target="_blank" rel="noreferrer">Kpt. Jaroše 496, Vrchlabí</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <img class="hero__media" src="/images/hero.webp" alt="Rozvoz prádla v krajině Krkonoš" fetchpriority="high" />
        <div class="hero__veil"></div>
        <div class="hero__content wrap">
          <p class="eyebrow eyebrow--light">PRÁDELENSKÝ SERVIS PRO FIRMY</p>
          <h1 id="hero-title">Čisté prádlo včas.<br />I v plné sezóně.</h1>
          <p class="hero__lead">Profesionální prádelenský servis pro hotely, penziony a gastro provozy v Krkonoších.</p>
          <div class="hero__actions">
            <a class="button" href="#poptavka">Poptat spolupráci</a>
            <a class="text-link text-link--light" href="tel:+420727839795">+420 727 839 795</a>
          </div>
        </div>
        <a class="hero__scroll" href="#pro-koho" aria-label="Pokračovat na další obsah">Objevte více<span aria-hidden="true">↓</span></a>
      </section>

      <section id="pro-koho" class="section section--clients">
        <div class="wrap">
          <div class="section-heading reveal">
            <p class="eyebrow">PRO KOHO</p>
            <h2>Pracujeme s provozy,<br />kde je spolehlivost klíčová</h2>
          </div>
          <div class="client-grid">
            {clients.map((client, index) => (
              <article class="client-card reveal" style={`--delay:${index * 70}ms`}>
                <a class="client-card__link" href={client.href}>
                  <div class="client-card__image">
                    <img src={client.image} alt="" loading="lazy" style={`object-position:${client.position}`} />
                  </div>
                  <span class="client-card__number">{String(index + 1).padStart(2, '0')}</span>
                  <div class="client-card__content">
                    <h3>{client.title}</h3>
                    <div class="client-card__details">
                      <div class="client-card__details-inner">
                        <p>{client.copy}</p>
                        <span class="text-link">Zjistit více <span aria-hidden="true">→</span></span>
                      </div>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="trust-strip" aria-label="Vybraní klienti">
        <div class="wrap trust-strip__inner">
          <div class="trust-strip__intro reveal">
            <p class="eyebrow">NAŠI PARTNEŘI</p>
            <h2>Partneři, kteří se vrací.</h2>
            <p>Pracujeme pro provozy, kde je spolehlivost součástí každého dne.</p>
          </div>
          <div class="trust-strip__logos reveal">
            <div class="logo-row">
              {[1, 2, 3, 4].map((logo) => <img src={`/icons/client-${logo}.svg`} alt="Partner Prádelny Krkonoše" loading="lazy" />)}
            </div>
          </div>
        </div>
      </section>

      <section id="sluzby" class="section service">
        <div class="wrap service__layout">
          <div class="service__content reveal">
            <p class="eyebrow">SLUŽBY</p>
            <h2>Kompletní prádelenský servis pro provozy v Krkonoších</h2>
            <p class="lead">Převezmeme péči o provozní textil od svozu až po návrat čistého prádla. V pravidelném rytmu, na který se můžete spolehnout.</p>
            <div class="benefit-list">
              {benefits.map((benefit) => (
                <div class="benefit">
                  <img src={benefit.icon} alt="" width="44" height="44" />
                  <div><h3>{benefit.title}</h3><p>{benefit.copy}</p></div>
                </div>
              ))}
            </div>
            <a class="button" href="#poptavka">Nezávazně poptat</a>
          </div>
          <figure class="service__image reveal" style="--delay:80ms">
            <img src="/images/service.webp" alt="Čistě připravený hotelový pokoj" loading="lazy" />
          </figure>
        </div>
      </section>

      <section class="section section--tint about">
        <div class="wrap about__layout">
          <div class="about__photos reveal">
            <img src="/images/about-1.webp" alt="Tým prádelny při práci" loading="lazy" />
            <img src="/images/about-2.webp" alt="Péče o provozní prádlo" loading="lazy" />
          </div>
          <div class="about__content reveal" style="--delay:80ms">
            <p class="eyebrow">O NÁS</p>
            <h2>Lokální prádelna, na kterou se můžete spolehnout</h2>
            <p class="lead">Jsme z Vrchlabí a rozumíme tempu horských provozů. Když přijde sezóna, potřebujete partnera, který zvedne telefon a dodrží domluvu.</p>
            <ul class="check-list">
              <li>Osobní domluva a rychlá reakce</li>
              <li>Pravidelný svoz přímo z provozu</li>
              <li>Kapacita připravená na sezónní špičky</li>
              <li>Hygienické standardy provozního praní</li>
            </ul>
            <a class="button button--outline" href="#kontakt">Více o nás</a>
          </div>
        </div>
      </section>

      <section id="jak-to-funguje" class="section process">
        <div class="wrap">
          <div class="section-heading section-heading--split reveal">
            <div><p class="eyebrow">JAK TO FUNGUJE</p><h2>Jak probíhá spolupráce<br />krok za krokem?</h2></div>
            <p>Od prvního kontaktu po pravidelný rozvoz. Jednoduše, přehledně a bez zbytečné administrativy.</p>
          </div>
          <ol class="steps">
            {steps.map((step, index) => (
              <li class="step reveal" style={`--delay:${index * 80}ms`}>
                <img src={step.image} alt="" loading="lazy" />
                <span class="step__number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.copy}</p>
              </li>
            ))}
          </ol>
          <div class="process__cta reveal"><span>Chcete mít prádlo bez starostí?</span><a class="button" href="#poptavka">Začít poptávku</a></div>
        </div>
      </section>

      <section id="faq" class="section section--tint faq">
        <div class="wrap faq__layout">
          <div class="reveal"><p class="eyebrow">ČASTÉ DOTAZY</p><h2>Často kladené otázky</h2><p class="lead">Nenašli jste odpověď? Zavolejte nám a probereme váš provoz konkrétně.</p></div>
          <div class="accordion reveal">
            {faqs.map(([question, answer], index) => (
              <details open={index === 0}>
                <summary>{question}<span aria-hidden="true">+</span></summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="kontakt" class="section contact">
        <div class="wrap contact__layout">
          <div class="contact__info reveal">
            <p class="eyebrow">KONTAKT</p>
            <h2>Máte zájem o spolupráci?</h2>
            <p class="lead">Napište nám pár základních informací. Ozveme se do 24 hodin a navrhneme další postup.</p>
            <address>
              <a href="tel:+420727839795"><span>Telefon</span><strong>+420 727 839 795</strong></a>
              <a href="mailto:info@pradelnakrkonose.cz"><span>E-mail</span><strong>info@pradelnakrkonose.cz</strong></a>
              <a href="https://maps.google.com/?q=Kpt.+Jaroše+496,+Vrchlabí" target="_blank" rel="noreferrer"><span>Adresa</span><strong>Kpt. Jaroše 496, 543 01 Vrchlabí 1</strong></a>
            </address>
            <a class="contact__map" href="https://maps.google.com/?q=Kpt.+Jaroše+496,+Vrchlabí" target="_blank" rel="noreferrer" aria-label="Otevřít adresu v mapách">
              <img src="/images/map.webp" alt="Mapa s polohou Prádelny Krkonoše ve Vrchlabí" loading="lazy" />
              <span class="contact__pin" aria-hidden="true"></span>
              <span class="contact__map-label">Otevřít v mapách ↗</span>
            </a>
          </div>

          <form id="poptavka" class="inquiry-form reveal" novalidate>
            <div class="form-heading"><p class="eyebrow">NEZÁVAZNÁ POPTÁVKA</p><h3>Řekněte nám o vašem provozu</h3></div>
            <label>Typ provozu
              <select name="provoz" required>
                <option value="">Vyberte typ provozu</option>
                <option>Hotel / wellness</option><option>Penzion / apartmány</option><option>Horská chata / chalupa</option><option>Restaurace / gastro</option><option>Jiný provoz</option>
              </select>
            </label>
            <label>Jméno a příjmení
              <input name="jmeno" autocomplete="name" placeholder="Jan Novák" required />
            </label>
            <div class="form-row">
              <label>Telefon<input type="tel" name="telefon" autocomplete="tel" placeholder="+420 777 000 000" required /></label>
              <label>E-mail<input type="email" name="email" autocomplete="email" placeholder="novak@email.cz" required /></label>
            </div>
            <label>Poznámka <span>(nepovinné)</span>
              <textarea name="poznamka" rows="5" placeholder="Přibližný objem, velikost zařízení, požadovaný rytmus svozu…"></textarea>
            </label>
            <label class="consent"><input type="checkbox" name="souhlas" required /><span>Souhlasím se zpracováním údajů za účelem vyřízení poptávky.</span></label>
            <div class="form-actions"><button class="button" type="submit">Odeslat poptávku</button><a class="button button--outline" href="tel:+420727839795">Raději zavolám</a></div>
            <p class="form-note">Ozveme se do 24 hodin. Bez závazků.</p>
            <p class="form-status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand"><img src="/logo-white.svg" alt="Prádelna Krkonoše" width="129" height="66" /><p>Spolupracujeme v souladu s hygienickými standardy provozního praní.</p></div>
        <div><h2>Rychlá navigace</h2><nav><a href="#sluzby">Služby</a><a href="#pro-koho">Typy provozů</a><a href="#jak-to-funguje">Jak to funguje</a><a href="#kontakt">Kontakt</a></nav></div>
        <div><h2>Kontakt</h2><a href="tel:+420727839795">+420 727 839 795</a><a href="mailto:info@pradelnakrkonose.cz">info@pradelnakrkonose.cz</a><p>Kpt. Jaroše 496, 543 01 Vrchlabí 1</p><p>IČO: 05593034</p></div>
      </div>
      <div class="wrap footer__bottom"><span>© 2026 Prádelna Krkonoše</span><span>Ochrana osobních údajů</span><span>Cookies</span><span>Vytvořeno: <strong>Jonáš Rech</strong></span></div>
    </footer>

    <script src="../scripts/site.ts"></script>
  </body>
</html>
