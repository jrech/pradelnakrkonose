<div class="logo-intro" data-logo-intro aria-hidden="true">
  <div class="logo-intro__wash"></div>
  <div class="logo-intro__mark">
    <img src="/logo-white.svg" alt="" width="129" height="66" />
  </div>
</div>

<script is:inline>
  (() => {
    const intro = document.querySelector('[data-logo-intro]');
    if (!intro) return;

    const key = 'pradelna-logo-intro-seen';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let alreadySeen = false;

    try {
      alreadySeen = window.sessionStorage.getItem(key) === '1';
      if (!alreadySeen) window.sessionStorage.setItem(key, '1');
    } catch {
      // If storage is unavailable, still allow the intro to complete once.
    }

    if (reduceMotion || alreadySeen) {
      intro.remove();
      return;
    }

    const startedAt = performance.now();
    const dismiss = () => {
      const remaining = Math.max(0, 760 - (performance.now() - startedAt));
      window.setTimeout(() => {
        intro.classList.add('is-done');
        window.setTimeout(() => intro.remove(), 240);
      }, remaining);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', dismiss, { once: true });
    } else {
      dismiss();
    }
  })();
</script>
