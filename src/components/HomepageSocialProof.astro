---
// Original homepage figures and logos; placeholder status is intentionally retained.
const partnerLogos = [
  { src: '/icons/client-1.svg', alt: 'Wellness Hotel Svornost' },
  { src: '/icons/client-2.svg', alt: 'Penzion Slunečná' },
  { src: '/icons/client-3.svg', alt: 'Hotel Harmony' },
  { src: '/icons/client-4.svg', alt: 'Restaurace Lesní dům' },
];

const placeholderStats = [
  { value: '10+', target: 10, suffix: '+', lineOne: 'let zkušeností', lineTwo: 'v profesionálním praní' },
  { value: '35+', target: 35, suffix: '+', lineOne: 'provozů', lineTwo: 'v Krkonoších' },
  { value: '200+', target: 200, suffix: '+', lineOne: 'svozů', lineTwo: 'každý měsíc' },
];
---

<section id="duvera" class="social-proof" aria-labelledby="social-proof-title" data-trust-scene>
  <img class="social-proof__background" src="/images/social-proof.webp" srcset="/images/social-proof-768.webp 768w, /images/social-proof.webp 1600w" sizes="100vw" alt="" aria-hidden="true" loading="lazy" decoding="async" data-trust-background />
  <div class="social-proof__veil" aria-hidden="true"></div>
  <div class="wrap social-proof__inner">
    <div class="social-proof__main">
      <div class="social-proof__intro">
        <p class="eyebrow eyebrow--light reveal">DŮVĚRA V PRAXI</p>
        <div class="reveal" style="--delay:80ms">
          <h2 id="social-proof-title">Prádlo pro desítky provozů.<br />Každý týden. Celou sezónu.</h2>
          <p class="social-proof__copy">Pravidelně se staráme o prádlo hotelů, penzionů, apartmánů a gastro provozů po celých Krkonoších.</p>
        </div>
      </div>
      <div class="social-proof__stats" data-placeholder="true">
        {placeholderStats.map((stat, index) => (
          <div class="social-proof__stat reveal" style={`--delay:${160 + index * 70}ms`}>
            <strong aria-label={stat.value}>
              <span class="social-proof__stat-number" data-count-up data-count-target={stat.target} data-count-delay={index * 100}>{stat.target}</span><span class="social-proof__stat-suffix" aria-hidden="true">{stat.suffix}</span>
            </strong>
            <p><span>{stat.lineOne}</span><span>{stat.lineTwo}</span></p>
          </div>
        ))}
      </div>
    </div>
    <div class="social-proof__partners reveal" style="--delay:240ms">
      <p>Důvěřují nám</p>
      <div class="social-proof__logos" aria-label="Vybraní klienti Prádelny Krkonoše">
        {partnerLogos.map((logo) => <img src={logo.src} alt={logo.alt} width="160" height="64" loading="lazy" decoding="async" />)}
      </div>
    </div>
  </div>
</section>

<style>
  .social-proof { position: relative; isolation: isolate; overflow: hidden; min-height: 92svh; display: flex; align-items: center; color: white; background: var(--ink); --reveal-distance: 12px; }
  .social-proof__background { position: absolute; z-index: -2; left: 0; top: -36px; width: 100%; max-width: none; height: calc(100% + 72px); object-fit: cover; object-position: center; }
  .social-proof__veil { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.62), rgba(0,0,0,.14) 57%, rgba(0,0,0,.5)), linear-gradient(180deg, rgba(0,0,0,.34), rgba(0,0,0,.3) 55%, rgba(0,0,0,.7)); }
  .social-proof__inner { padding-block: var(--space-section); }
  .social-proof__main { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(240px, .65fr); gap: clamp(64px, 8vw, 128px); align-items: center; }
  .social-proof__intro h2 { max-width: 760px; margin-bottom: 28px; font-size: clamp(2.5rem, 3.6vw, 3.75rem); line-height: 1.1; text-wrap: initial; }
  .social-proof__copy { max-width: 440px; margin: 0; font-size: 1.08rem; line-height: 1.7; color: rgba(255,255,255,.9); }
  .social-proof__stats { display: grid; gap: 32px; }
  .social-proof__stat strong { display: block; font-family: var(--display); font-size: clamp(4rem, 5.5vw, 5.5rem); font-weight: 500; letter-spacing: -.045em; line-height: 1; color: #b5eef0; }
  .social-proof__stat-number { display: inline-block; min-width: 3ch; font-variant-numeric: tabular-nums; }
  .social-proof__stat-suffix { display: inline-block; }
  .social-proof__stat p { margin: 8px 0 0; font-size: .9rem; line-height: 1.5; color: rgba(255,255,255,.88); }
  .social-proof__stat p span { display: block; }
  .social-proof__partners { display: grid; grid-template-columns: 180px 1fr; align-items: center; gap: 48px; margin-top: 64px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,.24); }
  .social-proof__partners > p { margin: 0; font-size: .8rem; color: rgba(255,255,255,.8); }
  .social-proof__logos { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); align-items: center; gap: 48px; }
  .social-proof__logos img { width: 100%; height: 64px; object-fit: contain; filter: brightness(0) invert(1); opacity: .82; }
  @media (max-width: 1050px) {
    .social-proof__main { grid-template-columns: minmax(0,1.3fr) minmax(200px,.7fr); gap: 48px; }
    .social-proof__partners { grid-template-columns: 1fr; gap: 24px; }
    .social-proof__logos { gap: 32px; }
  }
  @media (max-width: 820px) {
    .social-proof__main { grid-template-columns: 1fr; gap: 48px; }
    .social-proof__stats { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
    .social-proof__stat strong { font-size: 4rem; }
    .social-proof__background { top: 0; height: 100%; object-position: 38% center; }
    .social-proof__veil { background: linear-gradient(90deg,rgba(0,0,0,.7),rgba(0,0,0,.46)), linear-gradient(180deg,transparent,rgba(0,0,0,.4)); }
  }
  @media (max-width: 560px) {
    .social-proof__intro h2 { font-size: clamp(2rem,8.8vw,2.8rem); }
    .social-proof__copy { font-size: 1rem; }
    .social-proof__stats { grid-template-columns: 1fr; gap: 32px; }
    .social-proof__partners { margin-top: 48px; }
    .social-proof__logos { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28px 32px; }
    .social-proof__logos img { height: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-proof__background { transform: none !important; }
  }
</style>
