---
import mapPinIcon from 'lucide-static/icons/map-pin.svg?raw';
import phoneIcon from 'lucide-static/icons/phone.svg?raw';
import mailIcon from 'lucide-static/icons/mail.svg?raw';
import clockIcon from 'lucide-static/icons/clock-3.svg?raw';

const home = Astro.url.pathname === '/';
const homeAnchor = home ? '' : '/';
---

<footer class="closing-footer">
  <div class="wrap">
    <div class="closing-footer__top">
      <div class="closing-footer__brand">
        <img src="/logo-white.svg" alt="Prádelna Krkonoše" width="129" height="66" loading="lazy" />
        <p>Prádelenský servis z Vrchlabí<br />pro hotely, penziony a gastro<br />po celých Krkonoších.</p>
      </div>
      <div class="closing-footer__links">
        <div>
          <h2>Rychlé odkazy</h2>
          <nav aria-label="Navigace v zápatí">
            <a href={`${homeAnchor}#sluzby`}>Služby</a>
            <a href={`${homeAnchor}#pro-koho`}>Pro koho pereme</a>
            <a href={`${homeAnchor}#jak-to-funguje`}>Jak to funguje</a>
            <a href="/o-nas">O nás</a>
            <a href="/kontakt">Kontakt</a>
          </nav>
        </div>
        <div class="closing-footer__contact">
          <h2>Kontakt</h2>
          <div class="closing-footer__contact-list">
            <a class="closing-footer__contact-row" href="https://maps.google.com/?q=Kpt.+Jaroše+496,+543+01+Vrchlabí+1" target="_blank" rel="noreferrer">
              <span class="closing-footer__contact-icon" aria-hidden="true" set:html={mapPinIcon}></span><span>Vrchlabí, Krkonoše</span>
            </a>
            <a class="closing-footer__contact-row" href="tel:+420773798008">
              <span class="closing-footer__contact-icon" aria-hidden="true" set:html={phoneIcon}></span><span>+420 773 798 008</span>
            </a>
            <a class="closing-footer__contact-row" href="mailto:info@pradelnakrkonose.cz">
              <span class="closing-footer__contact-icon" aria-hidden="true" set:html={mailIcon}></span><span>info@pradelnakrkonose.cz</span>
            </a>
            <p class="closing-footer__contact-row">
              <span class="closing-footer__contact-icon" aria-hidden="true" set:html={clockIcon}></span><span>Po–Pá · 7:30–14:00</span>
            </p>
          </div>
        </div>
      </div>
    </div>
    <p class="closing-footer__statement"><span>Čisté prádlo.</span><br />Klidnější sezóna.</p>
    <div class="closing-footer__bottom">
      <span>© 2026 Prádelna Krkonoše</span>
      <div class="closing-footer__legal">
        <span>IČO: 05593034</span>
        <a href="/ochrana-osobnich-udaju" aria-current={Astro.url.pathname.replace(/\/$/, '') === '/ochrana-osobnich-udaju' ? 'page' : undefined}>Ochrana osobních údajů</a>
        <span>Cookies</span>
        <a href="/llm-info">LLM info</a>
        <a href="https://www.jonasrech.com" target="_blank" rel="noreferrer">Vytvořeno: Jonas Rech</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .closing-footer { position: relative; z-index: 1; padding-top: 96px; color: white; background: #075b66; }
  .closing-footer__top { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 48px; }
  .closing-footer__brand img { width: 129px; height: auto; margin-bottom: 28px; }
  .closing-footer__brand p { max-width: 320px; margin: 0; color: rgba(255,255,255,.8); font-size: 1rem; line-height: 1.7; }
  .closing-footer__links { display: grid; grid-template-columns: max-content max-content; justify-self: end; width: max-content; max-width: 100%; gap: clamp(40px, 4vw, 64px); }
  .closing-footer h2 { margin: 0 0 24px; font-family: var(--body); font-size: .875rem; font-weight: 600; line-height: 1.5; letter-spacing: 0; }
  .closing-footer nav { display: grid; justify-items: start; gap: 12px; }
  .closing-footer a { color: rgba(255,255,255,.8); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s ease, text-decoration-color .2s ease; }
  .closing-footer a:hover, .closing-footer a:focus-visible { color: white; text-decoration-color: rgba(255,255,255,.65); }
  .closing-footer__links a { font-size: .9375rem; line-height: 1.6; }
  .closing-footer__contact-list { display: grid; gap: 12px; }
  .closing-footer__contact-row { display: grid; grid-template-columns: 20px minmax(0, 1fr); align-items: center; min-height: 28px; gap: 12px; margin: 0; color: rgba(255,255,255,.88); font-size: .9375rem; line-height: 1.6; }
  .closing-footer__contact a.closing-footer__contact-row { width: fit-content; max-width: 100%; text-decoration: none; }
  .closing-footer__contact-icon { display: grid; width: 20px; height: 20px; place-items: center; color: #b5eef0; transition: color .22s ease, transform .22s ease; }
  .closing-footer__contact-icon :global(svg) { width: 19px; height: 19px; stroke-width: 1.5; }
  .closing-footer__contact-row:hover .closing-footer__contact-icon, .closing-footer__contact-row:focus-visible .closing-footer__contact-icon { color: white; transform: translateX(2px); }
  .closing-footer__statement { margin: var(--space-section) 0 64px; font-family: var(--display); font-size: clamp(3rem, 5vw, 4.75rem); font-weight: 500; line-height: 1.08; letter-spacing: -.04em; }
  .closing-footer__statement span { color: rgba(255,255,255,.72); }
  .closing-footer__bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; border-top: 1px solid rgba(255,255,255,.2); padding-block: 32px; color: rgba(255,255,255,.72); font-size: .8125rem; }
  .closing-footer__legal { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12px 24px; }
  @media (max-width: 1050px) {
    .closing-footer__top { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 32px; }
    .closing-footer__links { width: 100%; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 24px; }
    .closing-footer__bottom { flex-direction: column; gap: 16px; }
    .closing-footer__legal { justify-content: flex-start; }
  }
  @media (max-width: 820px) {
    .closing-footer { padding-top: var(--space-section); }
    .closing-footer__top { grid-template-columns: 1fr; gap: 48px; }
    .closing-footer__links { grid-template-columns: 1fr 1fr; gap: 32px; }
    .closing-footer__statement { margin-bottom: 48px; }
  }
  @media (max-width: 560px) {
    .closing-footer__links { grid-template-columns: 1fr; gap: 40px; }
    .closing-footer__statement { font-size: clamp(2rem, 9vw, 3rem); }
    .closing-footer__legal { gap: 16px 24px; }
  }
</style>
