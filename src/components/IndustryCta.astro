---
interface Props {
  title: string;
  copy: string;
}
const { title, copy } = Astro.props;
---

<section id="spoluprace" class="section segment-cta" aria-labelledby="segment-cta-title">
  <div class="wrap segment-cta__layout">
    <div class="reveal">
      <h2 id="segment-cta-title">{title}</h2>
      <p class="lead">{copy}</p>
    </div>
    <div class="segment-cta__actions reveal" style="--delay:80ms">
      <a class="button" href="#poptavka">Nezávazná poptávka</a>
      <a class="text-link" href="tel:+420773798008">Zavolejte nám</a>
    </div>
  </div>
</section>
